API_DOMAIN=hafsa.asos-it.uz
# Port bound to 127.0.0.1 on the VPS host (proxied by Nginx)
HOST_PORT=3101

POSTGRES_USER=funnel
POSTGRES_PASSWORD=funnel
POSTGRES_DB=funnel

PORT=3001
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
API_URL=https://hafsa.asos-it.uz
WEB_URL=https://hafsauztoza.vercel.app
CORS_ORIGINS=https://hafsauztoza.vercel.app
CHANNEL_URL=https://t.me/yourchannel
VIDEO_URL=https://hafsa-video.azeemov.uz/lesson-1/master.m3u8
VIDEO_POSTER_URL=https://hafsa-video.azeemov.uz/lesson-1/poster.webp
VIDEO_DURATION_SEC=
SEEK_LOCK=true
GATE_PROCEED=true
COMPLETE_THRESHOLD=0.7

# One-time bootstrap: while admin_users is empty, the API creates ADMIN_USERNAME (default admin) with this hash.
# Ignored once an admin exists; manage admins in the panel or with dist/admin-reset-password.js (docs/DEPLOY.md section 8).
ADMIN_PASSWORD_HASH='scrypt$...'
ADMIN_USERNAME=admin
# Legacy, unused since admin sessions moved to the database.
SESSION_SECRET=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_API_ROOT=http://telegram-bot-api:8081
BOT_WEBHOOK_URL=http://api:3001/bot
ADMIN_TELEGRAM_IDS=

LEADS_CHAT_ID=
LEADS_THREAD_ID=
MEDIA_CHAT_ID=

SHEETS_ENABLED=false
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
SHEET_ID=

FB_PIXEL_ID=
FB_CAPI_TOKEN=

# Receipt OCR (Payments). Optional: without a key, receipts are confirmed by hand only.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash

# Hermes mirror sync (optional, 32-256 chars). Unset disables POST /integrations/hermes/events (404).
HERMES_SYNC_SECRET=
